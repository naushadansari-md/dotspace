/* Matugen -> Rofi colors (Dynamic Template) */
* {
    /* Background and Foreground */
    background:     #121318;
    foreground:     #e2e2e9;
    
    /* Primary Accents */
    primary:        #b1c5ff;
    on-primary:     #172e60;
    
    /* UI Details */
    outline:        #8f9099;
    error:          #ffb4ab;
    
    /* Harmonized Secondary */
    secondary:      #c0c6dd;
}