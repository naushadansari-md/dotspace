/* Matugen -> Rofi colors (Dynamic Template) */
* {
    /* Background and Foreground */
    background:     #1a1111;
    foreground:     #f0dedd;
    
    /* Primary Accents */
    primary:        #ffb3b2;
    on-primary:     #561d1f;
    
    /* UI Details */
    outline:        #a08c8b;
    error:          #ffb4ab;
    
    /* Harmonized Secondary */
    secondary:      #e6bdbb;
}