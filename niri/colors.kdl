layout {
    focus-ring {
        active-color "#ffb0c9"
        inactive-color "#9e8c90"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb0c9"
        inactive-color "#9e8c90"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb0c9"
        inactive-color "#9e8c90"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb0c980"
    }
}

