// ────────────── Window Rules ──────────────

// Global style for all windows
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
    draw-border-with-background false
    opacity 1.0
}


// ────────────── Main Apps: Open Maximized ──────────────
window-rule {
    match app-id=r#"^(firefox|google-chrome|code|brave-browser|org\.mozilla\.Thunderbird|org\.pwmt\.zathura|Papers|idea)$"#
    open-maximized true
    background-effect {
        blur true
    }
}


// ────────────── Main Apps: Open floating ──────────────
window-rule{
            match app-id=r#"^(onedrive_tray|qt5ct|qt6ct|kvantummanager|nwg-look)$"#
            open-floating true
            max-width 640
            max-height 520
            background-effect {
                   blur true
    }
          

}

// ────────────── File Chooser / Picker Dialogs (SAFE) ──────────────
// Reduced keywords to avoid matching normal browser tabs
window-rule {
    match title=r#"(?i).*\b(open|save|save as|select|choose|picker)\b.*"#
    open-floating true
    min-width 640
    min-height 520
    max-width 1500
    max-height 920
    background-effect {
        blur true
    }
}


// ────────────── Dialogs / Settings / Auth Windows ──────────────
window-rule {
    match title=r#"(?i).*\b(dialog|properties|preferences|settings|authentication|permission|confirm|warning|error|about)\b.*"#
    open-floating true
    background-effect {
        blur true
    }
}


// ────────────── Picture-in-Picture (STRICT & SAFE) ──────────────
window-rule {
    // PiP windows use this exact title
    match title=r#"^Picture-in-Picture$"#

    open-floating true
    default-column-width  { fixed 512; }
    default-window-height { fixed 288; }

    // Gap from bottom-right corner
    default-floating-position x=30 y=30 relative-to="bottom-right"
    background-effect {
        blur true
    }
}


// ────────────── Media Players ──────────────
window-rule {
    match app-id=r#"^(mpv|vlc)$"#
    open-floating true
    default-column-width  { fixed 1100; }
    default-window-height { fixed 680; }
    background-effect {
        blur true
    }
}


// ────────────── Terminals ──────────────
window-rule {
    match app-id=r#"^(kitty|Alacritty|foot)$"#
    opacity 1.0
    background-effect {
        blur true
    }
}


// ────────────── Inactive Windows (except terminals) ──────────────
window-rule {
    match is-active=false
    exclude app-id=r#"^(kitty|Alacritty|foot)$"#
    opacity 1.0
    background-effect {
        blur true
    }
}


// ────────────── Privacy: Password Managers ──────────────
window-rule {
    match app-id=r#"^(org\.keepassxc\.KeePassXC|Enpass)$"#
    block-out-from "screen-capture"
    background-effect {
        blur true
    }
}


// ────────────── Small Utility Apps ──────────────
window-rule {
    match app-id=r#"^(gnome-calculator|org\.gnome\.Calculator)$"#
    open-floating true
    default-column-width  { fixed 420; }
    default-window-height { fixed 520; }
    background-effect {
        blur true
    }
}
